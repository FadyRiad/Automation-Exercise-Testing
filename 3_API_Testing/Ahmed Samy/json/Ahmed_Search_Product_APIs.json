  "item": [
    {
      "name": "API 4 - PUT To All Brands List",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Response code is 405\", function () {\r",
              "    let response = pm.response.json();\r",
              "    pm.expect(response.responseCode).to.eql(405);\r",
              "});\r",
              "\r",
              "pm.test(\"Response time is less than 2000ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
              "});\r",
              "\r",
              "let response = pm.response.json();\r",
              "\r",
              "pm.test(\"Correct error message\", function () {\r",
              "    pm.expect(response.message).to.include(\"This request method is not supported\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [],
        "url": {
          "raw": "{{Base_URL}}/brandsList",
          "host": [
            "{{Base_URL}}"
          ],
          "path": [
            "brandsList"
          ]
        }
      },
      "response": []
    },
